{
  "name": "@kerno/effects",
  "version": "0.1.0",
  "description": "Kerno graphics and visual effects: Shape, Surface, Elevation, Acrylic and Motion.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mahoo12138/kerno.git",
    "directory": "packages/effects"
  },
  "homepage": "https://github.com/mahoo12138/kerno#readme",
  "bugs": {
    "url": "https://github.com/mahoo12138/kerno/issues"
  },
  "keywords": [
    "kerno",
    "acrylic",
    "reveal-highlight",
    "fluent",
    "canvas",
    "web-components"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": [
    "./dist/define.js",
    "./dist/**/define.js",
    "./src/define.ts",
    "./src/**/define.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "source": "./src/define.ts",
      "default": "./dist/define.js"
    },
    "./shape": {
      "types": "./dist/shape/index.d.ts",
      "source": "./src/shape/index.ts",
      "default": "./dist/shape/index.js"
    },
    "./shape/lazy": {
      "types": "./dist/shape/lazy.d.ts",
      "source": "./src/shape/lazy.ts",
      "default": "./dist/shape/lazy.js"
    },
    "./surface": {
      "types": "./dist/surface/index.d.ts",
      "source": "./src/surface/index.ts",
      "default": "./dist/surface/index.js"
    },
    "./surface/define": {
      "types": "./dist/surface/define.d.ts",
      "source": "./src/surface/define.ts",
      "default": "./dist/surface/define.js"
    },
    "./acrylic": {
      "types": "./dist/acrylic/index.d.ts",
      "source": "./src/acrylic/index.ts",
      "default": "./dist/acrylic/index.js"
    },
    "./elevation": {
      "types": "./dist/elevation/index.d.ts",
      "source": "./src/elevation/index.ts",
      "default": "./dist/elevation/index.js"
    },
    "./motion": {
      "types": "./dist/motion/index.d.ts",
      "source": "./src/motion/index.ts",
      "default": "./dist/motion/index.js"
    },
    "./reveal": {
      "types": "./dist/reveal/index.d.ts",
      "source": "./src/reveal/index.ts",
      "default": "./dist/reveal/index.js"
    },
    "./pressure": {
      "types": "./dist/pressure/index.d.ts",
      "source": "./src/pressure/index.ts",
      "default": "./dist/pressure/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@kerno/core": "workspace:^",
    "@kerno/tokens": "workspace:^",
    "tslib": "^2.9.1"
  }
}
