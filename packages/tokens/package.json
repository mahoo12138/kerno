{
  "name": "@kerno/tokens",
  "version": "0.1.0",
  "description": "Kerno design tokens and theming.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mahoo12138/kerno.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/mahoo12138/kerno#readme",
  "bugs": {
    "url": "https://github.com/mahoo12138/kerno/issues"
  },
  "keywords": [
    "kerno",
    "design-tokens",
    "css-variables",
    "fluent",
    "theming"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/css/tokens.css",
    "./base.css": "./dist/css/base.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/build-css.mjs"
  }
}
