{
  "name": "@kerno/components",
  "version": "0.0.0",
  "description": "Kerno composite interaction and navigation components.",
  "type": "module",
  "sideEffects": [
    "./dist/define.js",
    "./dist/**/define.js",
    "./src/define.ts",
    "./src/**/define.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "source": "./src/define.ts",
      "default": "./dist/define.js"
    },
    "./dialog": {
      "types": "./dist/dialog/index.d.ts",
      "source": "./src/dialog/index.ts",
      "default": "./dist/dialog/index.js"
    },
    "./dialog/define": {
      "types": "./dist/dialog/define.d.ts",
      "source": "./src/dialog/define.ts",
      "default": "./dist/dialog/define.js"
    },
    "./popover": {
      "types": "./dist/popover/index.d.ts",
      "source": "./src/popover/index.ts",
      "default": "./dist/popover/index.js"
    },
    "./popover/define": {
      "types": "./dist/popover/define.d.ts",
      "source": "./src/popover/define.ts",
      "default": "./dist/popover/define.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip/index.d.ts",
      "source": "./src/tooltip/index.ts",
      "default": "./dist/tooltip/index.js"
    },
    "./tooltip/define": {
      "types": "./dist/tooltip/define.d.ts",
      "source": "./src/tooltip/define.ts",
      "default": "./dist/tooltip/define.js"
    },
    "./dropdown": {
      "types": "./dist/dropdown/index.d.ts",
      "source": "./src/dropdown/index.ts",
      "default": "./dist/dropdown/index.js"
    },
    "./dropdown/define": {
      "types": "./dist/dropdown/define.d.ts",
      "source": "./src/dropdown/define.ts",
      "default": "./dist/dropdown/define.js"
    },
    "./tabs": {
      "types": "./dist/tabs/index.d.ts",
      "source": "./src/tabs/index.ts",
      "default": "./dist/tabs/index.js"
    },
    "./tabs/define": {
      "types": "./dist/tabs/define.d.ts",
      "source": "./src/tabs/define.ts",
      "default": "./dist/tabs/define.js"
    },
    "./navigation": {
      "types": "./dist/navigation/index.d.ts",
      "source": "./src/navigation/index.ts",
      "default": "./dist/navigation/index.js"
    },
    "./navigation/define": {
      "types": "./dist/navigation/define.d.ts",
      "source": "./src/navigation/define.ts",
      "default": "./dist/navigation/define.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@kerno/core": "workspace:^",
    "@kerno/effects": "workspace:^",
    "@kerno/primitives": "workspace:^",
    "@kerno/tokens": "workspace:^",
    "tslib": "^2.9.1"
  }
}
