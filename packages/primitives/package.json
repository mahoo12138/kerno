{
  "name": "@kerno/primitives",
  "version": "0.0.0",
  "description": "Kerno primitive controls.",
  "type": "module",
  "sideEffects": [
    "./dist/define.js",
    "./dist/**/define.js",
    "./src/define.ts",
    "./src/**/define.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "source": "./src/define.ts",
      "default": "./dist/define.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "source": "./src/button/index.ts",
      "default": "./dist/button/index.js"
    },
    "./button/define": {
      "types": "./dist/button/define.d.ts",
      "source": "./src/button/define.ts",
      "default": "./dist/button/define.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@kerno/core": "workspace:^",
    "@kerno/tokens": "workspace:^",
    "tslib": "^2.9.1"
  }
}
