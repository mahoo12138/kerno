  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@kerno/core": "workspace:^",
    "@kerno/effects": "workspace:^",
    "@kerno/tokens": "workspace:^",
    "tslib": "^2.9.1"
