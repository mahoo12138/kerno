{
  "name": "@kerno/primitives",
  "version": "0.0.0",
  "description": "Kerno primitive controls.",
  "type": "module",
  "sideEffects": [
    "./dist/define.js",
    "./dist/**/define.js",
    "./src/define.ts",
    "./src/**/define.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "source": "./src/define.ts",
      "default": "./dist/define.js"
    },
