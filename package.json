{
  "name": "kerno-monorepo",
  "private": true,
  "type": "module",
  "description": "Kerno — A Modular Web Component System. Build interfaces with structure.",
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "clean": "pnpm -r exec rm -rf dist tsconfig.tsbuildinfo",
    "dev": "pnpm build && pnpm --filter @kerno/playground dev",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/analyze-size.mjs",
    "size:check": "node scripts/analyze-size.mjs --check",
    "release:verify": "node scripts/release.mjs verify",
    "release:version": "node scripts/release.mjs version",
    "release:publish": "node scripts/release.mjs publish",
    "release:dry-run": "node scripts/release.mjs publish --dry-run",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
